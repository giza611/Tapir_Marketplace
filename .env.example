# Copy to .env.local for development. None of these are required to run the
# public marketplace — it is fully static and works with an empty env file.
# Each block below unlocks one optional capability.

# ---------------------------------------------------------------------------
# Contributor sign-in and the dashboard
# ---------------------------------------------------------------------------
# Register an OAuth App at https://github.com/settings/developers
#   Homepage URL:               https://your-domain
#   Authorization callback URL: https://your-domain/api/auth/callback
# For local development register a second app pointing at http://localhost:3000.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encrypts the session cookie that holds each contributor's GitHub token.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this signs everyone out; it never needs to be shared with anyone.
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Comments and forum (giscus → GitHub Discussions)
# ---------------------------------------------------------------------------
# Already filled in for giza611/Tapir_Marketplace, where Discussions is enabled.
# If you fork or transfer the repository, regenerate these at https://giscus.app.
# Without them the comment sections render a setup notice rather than failing.
#
# Comments also require the giscus GitHub App to be installed on the repository:
#   https://github.com/apps/giscus
NEXT_PUBLIC_GISCUS_REPO=giza611/Tapir_Marketplace
NEXT_PUBLIC_GISCUS_REPO_ID=R_kgDOTq_hxQ
NEXT_PUBLIC_GISCUS_CATEGORY=General
NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDOTq_hxc4DCgmh

# ---------------------------------------------------------------------------
# Build-time data
# ---------------------------------------------------------------------------
# Read-only token used at build time to render the /forum index and to collect
# download counts. In GitHub Actions the built-in token covers this; set it here
# for Vercel builds and for running scripts/refresh-stats.ts locally.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://tapir-marketplace.vercel.app
# Only needed if the repo is moved to a different owner or renamed.
NEXT_PUBLIC_REPO_OWNER=giza611
NEXT_PUBLIC_REPO_NAME=Tapir_Marketplace
