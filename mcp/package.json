  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "archicad",
    "tapir",
    "bim",
    "marketplace",
    "automation"
  ],
  "homepage": "https://github.com/giza611/Tapir_Marketplace/tree/main/mcp#readme",
